{
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "你的宝石……闪闪发光。是月光的颜色。",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "月光？哈哈，小丫头，我的宝石可比月光值钱多啦！",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "又来啦？我记得你！那个扛着比自己还大的剑的小兔子！",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "你找什么呢？在我这堆宝贝里，有没有你想要的？",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "回应",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "……我在找能让剑更锋利的东西。",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "DARV.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "锋利？哈哈！那你找对地方了！来挑一块——算你便宜点！",

  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "……又见面了。",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "[sine]...去... 塔里... ..挥舞你的剑.....[/sine]",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "[sine]...月光... ..指引着你.....[/sine]",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "[sine]...你.. 还缺... ..什么...？[/sine]",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "祈求",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "让我的剑……再亮一点。",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "NEOW.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "[sine]...如你所愿... \n..月光.. 将与你...同行.....[/sine]",

  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "你的衣服……真漂亮。",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "哎呀，小兔子真有眼光！接受我的赐福，你会更漂亮的！",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "你和你的大剑都需要新衣服！快来让我打扮打扮你们！",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "就算扛着那么大的剑，你也依然优雅呢。来，让我为你增添一抹光彩。",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "婉拒",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "……我只需要剑够锋利。",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "NONUPEIPE.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "哎呀呀，真是不解风情！拿去吧——让你的剑也闪闪发亮！",

  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "你跳得真高。",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "兔子当然跳得高！！来打一架！！",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "大剑小兔子！！再来再来！！我还没看够！！",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "你拿剑的样子真帅！！送你个东西！！",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "回应",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "……谢谢你。",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "OROBAS.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "不用谢不用谢！！下次挥剑的时候喊我名字！！",

  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "你在睡觉吗？……我可以坐在旁边吗？",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "[thinky_dots]嗯……坐吧……月光很软……[/thinky_dots]",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "[thinky_dots]小兔子……剑很重吧……歇一会儿……[/thinky_dots]",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "[thinky_dots]拿走我的一部分吧……让你在月光下睡得更安稳……[/thinky_dots]",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "回答",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "我不怕痛。只怕……剑变钝了。",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "PAEL.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "[thinky_dots]傻孩子……剑钝了可以磨……人累了要休息啊……[/thinky_dots]",

  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "你的剑……看起来很厉害。",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "[b]那当然！！但你的小身板拿得动吗？！[/b]",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "[b]又来挑战了？！好！！让我看看你的剑有多锋利！！[/b]",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "[b]小兔子！！和我一战！！用你的大剑证明你的力量！！[/b]",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "退让",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "……我不是来打架的。我只是路过。",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "TANX.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "[b]胆小鬼！！但你的眼神很坚定！！收下这份力量吧！[/b]",

  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "火堆……很暖。",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "小兔耳都冻红啦，快进来烤烤火吧~",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "你又来啦~ 大剑擦好了吗？来，我帮你磨一磨~",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "亲爱的，尝尝我做的[jitter][b]月光饼干[/b][/jitter]吧~ 凉了就不好吃了哦。",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "推辞",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "……谢谢你。但是我不能吃陌生人的东西。",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "TEZCATARA.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "哎呀，还挺有戒心呢~ 那我把这份力量给你吧，就当是见面礼~",

  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.char": "你是恶魔？……你的角好漂亮。",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0.next": "继续",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1.ancient": "哦？赞美我的角？有趣的小兔子。你想要什么？",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "你又来了。每次来都带着那把沉重的剑……你不累吗？",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.ancient": "让我看看……你的灵魂里有月光的味道。我可以给你力量——代价是[sine]一点点耳朵[/sine]，怎么样？",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0.next": "回应",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.char": "耳朵不行。别的都可以。",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1.next": "继续",
  "VAKUU.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2.ancient": "哈哈！真是可爱的坚持。好吧——收下这份力量，下次我再想想要什么。",

  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0r.ancient": "小兔子，你为什么来这里？为了变强？为了复仇？还是……为了找什么人？",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-0r.next": "回答",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1r.char": "……我只是想走到塔顶。看看那里的月光。",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-1r.next": "继续",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.0-2r.ancient": "塔顶的月光？愚蠢。塔的顶端，只有[red]我[/red]。",

  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.ancient": "你又失败了。还不放弃？",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-0r.next": "继续",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-1r.char": "剑还没断，我就不会放弃。",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-1r.next": "继续",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.1-2r.ancient": "……有意思。那就继续吧。让我看看你能坚持到什么地步。",

  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0r.ancient": "你一次次地回来，就为了那虚无缥缈的月光？",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-0r.next": "继续",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1r.char": "月光不是虚无的。它一直都在。",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-1r.next": "继续",
  "THE_ARCHITECT.talk.RAS_FOR_STS2_CHARACTER_XILA_CHARACTER.2-2r.ancient": "……好吧。那就用你的剑来证明——月光，到底值不值得你这样追逐。"
}
